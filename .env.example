# Copia este archivo a `.env` y rellena los valores.
# cp .env.example .env

# --- Supabase ---
# Dashboard: Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (IA, Parte 8 del plan) ---
OPENROUTER_API_KEY=
# Modelo por defecto del MVP: openai/gpt-oss-120b:free
# Si OpenRouter indica que la variante free no está disponible, usa por ejemplo:
# OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=
